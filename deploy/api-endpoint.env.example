# ~/appliance/api-endpoint.env, mode 0600 — the appliance shape. No secret
# lives here: there is no phoenixd, no price, no budget, no token.
# systemd's EnvironmentFile expands nothing: write absolute paths.

# The door. 127.0.0.1 = this box only; the LAN address the lab's systems
# reach is the only other sensible value, and whatever can reach it can
# submit records (README, "The one route").
LISTEN_ADDR=127.0.0.1:8402
# The box's own calendar, on loopback (docker-compose.enterprise.yml).
CALENDAR_URL=http://127.0.0.1:14788
# Where debts/, proofs/, pending/, heartbeat and log live. REQUIRED here: the
# default is the script's own directory, which is the read-only clone.
DATA_DIR=/home/appliance/appliance/endpoint-data
# Appliance defaults, written out so they are visible: eight submissions in
# the air; one upgrade pass an hour (one loopback GET per pending proof).
INFLIGHT=8
UPGRADE_SECS=3600
# The event log rotates to log.1 at this size; 0 never rotates.
LOG_CAP_BYTES=16777216
